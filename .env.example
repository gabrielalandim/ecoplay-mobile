# URL base da API Java (Spring Boot). No emulador Android use http://10.0.2.2:8080
# e no celular físico use o IP da sua máquina na rede, ex.: http://192.168.0.10:8080
EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# URL base do serviço que expõe POST /api/ia/identificar (Java como gateway ou Python direto).
# Deixe vazio para usar a própria API Java.
EXPO_PUBLIC_IA_URL=

# true = usa identificação simulada até a integração Java -> Python ficar pronta
EXPO_PUBLIC_IA_MOCK=true

# URL base da API .NET de gamificação (progresso, missões e quiz).
# Vazio = XP calculado no app a partir das entregas da API Java.
EXPO_PUBLIC_GAMIFICACAO_URL=
