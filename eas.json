{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8080",
        "EXPO_PUBLIC_IA_MOCK": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ecoplay-api-xows.onrender.com",
        "EXPO_PUBLIC_IA_URL": "https://ecoplay-ai.onrender.com",
        "EXPO_PUBLIC_IA_MOCK": "false",
        "EXPO_PUBLIC_GAMIFICACAO_URL": "https://ecoplay-gamification-api.onrender.com"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://ecoplay-api-xows.onrender.com",
        "EXPO_PUBLIC_IA_URL": "https://ecoplay-ai.onrender.com",
        "EXPO_PUBLIC_IA_MOCK": "false",
        "EXPO_PUBLIC_GAMIFICACAO_URL": "https://ecoplay-gamification-api.onrender.com"
      }
    }
  }
}
