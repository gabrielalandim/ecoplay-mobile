{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": false,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8080",
        "EXPO_PUBLIC_IA_MOCK": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SEU-WEBAPP-JAVA.azurewebsites.net",
        "EXPO_PUBLIC_IA_URL": "",
        "EXPO_PUBLIC_IA_MOCK": "true",
        "EXPO_PUBLIC_GAMIFICACAO_URL": ""
      }
    },
    "production": {
      "android": { "buildType": "app-bundle" },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://SEU-WEBAPP-JAVA.azurewebsites.net",
        "EXPO_PUBLIC_IA_MOCK": "false"
      }
    }
  }
}
